{
	"trailingComma": "none",
	"useTabs": true,
	"semi": false,
	"tabWidth": 2,
	"jsxSingleQuote": true,
	"singleQuote": true,
	"arrowParens": "avoid",
	"importOrder": [
		"^node:",
		"<THIRD_PARTY_MODULES>",
		"^@app/(.*)$",
		"^@pages/(.*)$",
		"^@shared/(.*)$",
		"^@server/(.*)$",
		"^../(.*)$",
		"^./(.*)$",
		"^.+/.(css|scss)$"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"plugins": ["@trivago/prettier-plugin-sort-imports"]
}
