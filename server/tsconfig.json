{
	"compilerOptions": {
		"tsBuildInfoFile": "../node_modules/.tmp/tsconfig.server.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"baseUrl": ".",
		"paths": {
			"@server/*.js": ["src/*.ts"],
			"@server/*": ["src/*"]
		},
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
